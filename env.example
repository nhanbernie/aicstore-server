# =================================
# WDP Server Environment Variables
# =================================

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_password_here
DATABASE_NAME=wdp_server

# JWT Configuration - CHANGE THESE IN PRODUCTION!
# Use a strong, random secret (minimum 256 bits / 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-256-bits
JWT_EXPIRES_IN=15m

# Refresh Token Configuration
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-256-bits
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing Configuration
BCRYPT_ROUNDS=12

# =================================
# Optional Configuration
# =================================

# Logging Level (error, warn, info, debug)
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration  
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# =================================
# External Services (if needed)
# =================================

# Redis Configuration (for caching/sessions)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Email Service Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=dliltuh7x
CLOUDINARY_API_KEY=926625935643847
CLOUDINARY_API_SECRET=uqPA38YWXBqXFv3v7U_w_1FRBpQ
CLOUDINARY_FOLDER=wdp-products

# =================================
# Development Only
# =================================

# Set to true to enable debug mode
DEBUG=false

# Database logging in development
DB_LOGGING=true

# Enable TypeORM synchronization (development only!)
DB_SYNC=true
